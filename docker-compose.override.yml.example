# Example override file for local development
# Copy this to docker-compose.override.yml to customize settings
# This file is automatically loaded by docker-compose if it exists

version: '3.8'

services:
  backend:
    # Mount source code for hot-reload during development
    volumes:
      - ./app:/app/app
      - ./requirements.txt:/app/requirements.txt
    # Override command for development with auto-reload
    command: ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
  
  frontend:
    # For development, you might want to use the dev server instead
    # Uncomment below to use Vite dev server (requires different setup)
    # build:
    #   context: .
    #   dockerfile: Dockerfile.frontend.dev
    volumes:
      - ./frontend/src:/app/src
